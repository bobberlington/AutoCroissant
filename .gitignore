# ===================================
# Python
# ===================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ===================================
# Cython Build Artifacts
# ===================================
# C/C++ source files generated by Cython
*.c
*.cpp

# Compiled extension modules (comments can't share a line with a pattern in .gitignore)
# Linux/Mac
*.so
# Windows
*.pyd
*.dll

# HTML annotation files (if linetrace=True)
*.html

# Build directories
build/
dist/
*.egg-info/

# ===================================
# Discord Bot Specific
# ===================================
# Configuration with tokens/secrets
config.py
.ssh/

reminder.pkl
# reminders are saved by writing this temp file and renaming it; one can be left behind after a crash
reminder.pkl.tmp
# image link commits, rebuilt from the card repo's history (commands/repo_history.py)
repo_history.json
repo_history.json.tmp
# type emoji name -> icon blob it was made from (commands/type_emojis.py)
type_emojis.json
type_emojis.json.tmp

# Music downloads
music/
!music/.gitkeep

# Claude Code: personal settings stay local (the shared .claude/skills/ library is committed)
.claude/settings.local.json

# ===================================
# IDE / Editor
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===================================
# Logs
# ===================================
*.log
logs/
*.csv
*.txt
!requirements-dev.txt

# ===================================
# Virtual Environments
# ===================================
venv/
env/
ENV/
.venv/

# ===================================
# OS
# ===================================
Thumbs.db
.DS_Store