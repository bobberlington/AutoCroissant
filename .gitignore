# ===================================
# Python
# ===================================
__pycache__/
*.py[cod]
*$py.class
.Python

# ===================================
# Cython Build Artifacts
# ===================================
# C/C++ source files generated by Cython
*.c
*.cpp

# Compiled extension modules (comments can't share a line with a pattern in .gitignore)
# Linux/Mac
*.so
# Windows
*.pyd
*.dll

# HTML annotation files (if linetrace=True)
*.html

# Build directories
build/
dist/
*.egg-info/

# ===================================
# Discord Bot Specific
# ===================================
# Configuration with tokens/secrets
config.py
.ssh/

# image link commits, rebuilt from the card repo's history (commands/repo_history.py)
repo_history.json
repo_history.json.tmp
# per bot: type emoji name -> icon blob it was made from (commands/type_emojis.py)
type_emojis.json
type_emojis.json.tmp
# the bot's copy of the card data (the data branch's db/) after the cutover (commands/card_sync.py)
card_data/

# Music downloads
music/

# Claude Code: personal settings stay local (the shared .claude/skills/ library is committed)
.claude/settings.local.json

# ===================================
# IDE / Editor
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~

# ===================================
# Logs
# ===================================
*.log
logs/
*.csv
*.txt
!requirements-dev.txt
!requirements-cards.txt

# ===================================
# Virtual Environments
# ===================================
venv/
env/
ENV/
.venv/

# ===================================
# OS
# ===================================
Thumbs.db
.DS_Store

# reminders, per machine: the store, its temp file, the old pickle store (converted 2026-10-24; never committed)
/reminder.json
reminder.json.tmp
reminder.pkl
reminder.pkl.bak
